{
  "schemaVersion": 1,
  "id": "dansmith888.cpu",
  "name": "CPU",
  "version": "1.0.0",
  "author": "Daniel Smith",
  "license": "MIT",
  "description": "CPU load, per-core activity, temperature and clock in the Omarchy bar",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "CPU",
    "description": "Load, temperature and clock in the bar; per-core bars, a load graph, sensors and the busiest processes in the panel.",
    "category": "Hardware",
    "aliases": [
      "cpu",
      "processor",
      "load"
    ],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "pollIntervalMs": 2000,
      "showIcon": true,
      "showUsage": true,
      "showTemp": true,
      "showClock": false,
      "showPower": false,
      "tempSensor": "auto",
      "temperatureUnit": "C",
      "historySamples": 60,
      "warnFrom": 50,
      "alertFrom": 85,
      "warnColor": "",
      "alertColor": "",
      "topCount": 5,
      "processScale": "total",
      "pptWatts": 0
    },
    "schema": [
      {
        "key": "pollIntervalMs",
        "type": "integer",
        "label": "Refresh interval (ms)",
        "min": 500,
        "max": 60000,
        "step": 500,
        "defaultValue": 2000
      },
      {
        "key": "showIcon",
        "type": "boolean",
        "label": "Show the chip icon",
        "defaultValue": true
      },
      {
        "key": "showUsage",
        "type": "boolean",
        "label": "Show load in the bar",
        "defaultValue": true
      },
      {
        "key": "showTemp",
        "type": "boolean",
        "label": "Show temperature in the bar",
        "defaultValue": true
      },
      {
        "key": "showClock",
        "type": "boolean",
        "label": "Show clock in the bar",
        "defaultValue": false
      },
      {
        "key": "showPower",
        "type": "boolean",
        "label": "Show CPU package power in the bar",
        "defaultValue": false,
        "description": "Needs read access to /sys/class/powercap/intel-rapl:*/energy_uj; hidden when the kernel keeps it root-only."
      },
      {
        "key": "tempSensor",
        "type": "string",
        "label": "Temperature sensor",
        "defaultValue": "auto",
        "description": "A hwmon label such as Tctl, or auto to pick the package sensor."
      },
      {
        "key": "temperatureUnit",
        "type": "enum",
        "label": "Temperature unit",
        "options": [
          "C",
          "F"
        ],
        "defaultValue": "C"
      },
      {
        "key": "historySamples",
        "type": "integer",
        "label": "Graph history (samples)",
        "min": 20,
        "max": 240,
        "step": 10,
        "defaultValue": 60
      },
      {
        "key": "warnFrom",
        "type": "integer",
        "label": "Warning from (%)",
        "min": 5,
        "max": 100,
        "step": 5,
        "defaultValue": 50
      },
      {
        "key": "alertFrom",
        "type": "integer",
        "label": "Alert from (%)",
        "min": 5,
        "max": 100,
        "step": 5,
        "defaultValue": 85
      },
      {
        "key": "topCount",
        "type": "integer",
        "label": "Processes listed",
        "min": 1,
        "max": 10,
        "step": 1,
        "defaultValue": 5
      },
      {
        "key": "processScale",
        "type": "enum",
        "label": "Process CPU shown as",
        "options": [
          "total",
          "core"
        ],
        "defaultValue": "total",
        "description": "total: every thread busy reads 100%. core: the top(1) convention, where one busy thread reads 100%."
      },
      {
        "key": "pptWatts",
        "type": "integer",
        "label": "CPU PPT (watts, 0 = hide power)",
        "min": 0,
        "max": 1000,
        "step": 1,
        "defaultValue": 0,
        "description": "Package Power Tracking: the sustained package power your CPU may draw, which is what the power bar is measured against. Not the TDP \u2014 a Ryzen 9 3900X is 105 W TDP but 142 W PPT."
      }
    ]
  }
}
