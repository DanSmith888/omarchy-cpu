#!/usr/bin/env python3
"""cpustatus — one JSON line describing what Cpu shows.

    {"present": true, "label": "...", "value": 42}

Exits 0 with an empty object when there is nothing to show — the widget
hides itself rather than showing a stale value. A key set to null means
"unsupported / no answer" and hides that one control.

Standard library only. No root, no network.
"""

import json
import os
import subprocess

HERE = os.path.dirname(os.path.abspath(__file__))
TIMEOUT = 10


def run(cmd, timeout=TIMEOUT):
    """stdout on success, None on any failure. Never raises, never hangs."""
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return r.stdout if r.returncode == 0 else None
    except Exception:
        return None


def discover():
    """Return something truthy when the thing this plugin shows is present.

    TODO: replace. Keep it cheap — this runs every poll.
    """
    return True


def main():
    if not discover():
        print("{}")
        return

    state = {"present": True, "label": "", "value": None}

    out = run([os.path.join(HERE, "cpuctl"), "get", "--json"])
    if out:
        try:
            d = json.loads(out)
            state["label"] = d.get("label", "")
            state["value"] = d.get("value")
            # TODO: copy further fields; leave None for unsupported ones.
        except json.JSONDecodeError:
            pass

    print(json.dumps(state))


if __name__ == "__main__":
    main()
