#!/usr/bin/env python3
"""cpuctl — command-line backend for the CPU Omarchy plugin.

Standard library only: no daemon, no background process. Each invocation
reads /proc and /sys, diffs against the previous sample kept in
$XDG_RUNTIME_DIR, prints, and exits.

Usage:
  cpuctl get [--json]          usage, per-core, temperatures, clock, load, memory, top
  cpuctl top [--json] [-n N]   busiest processes since the previous sample
  cpuctl doctor                check every link from /proc to the bar
"""

import argparse
import fcntl
import glob
import json
import os
import re
import sys
import time
import stat
import tempfile

PLUGIN_ID = "dansmith888.cpu"
REPO_URL = "https://github.com/DanSmith888/omarchy-cpu.git"
REQUIRED_FILES = ("manifest.json", "BarWidget.qml", "Panel.qml", "Model.js",
                  "Sparkline.qml", "bin/cpustatus", "bin/cpuctl")

# Never /tmp: a predictable shared path could be pre-created by another user.
_RUNTIME_DIR = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
# Our own 0700 directory inside the runtime dir, rather than predictable names
# sitting directly in a shared one. Everything below opens with O_NOFOLLOW and
# checks it got a regular file, so a symlink planted at one of these paths is
# refused rather than followed and truncated.
_STATE_DIR = os.path.join(_RUNTIME_DIR, PLUGIN_ID)
LOCK_PATH = os.path.join(_STATE_DIR, "lock")
STATE_PATH = os.path.join(_STATE_DIR, "state.json")
# Ceiling on the state file read: it is ours, but read it as untrusted anyway.
MAX_STATE_BYTES = 4 * 1024 * 1024


def state_dir():
    """Our private runtime directory, verified before use.

    Creating it is not enough: check with lstat that what is there is a real
    directory we own, not a symlink pointing somewhere else, and that nobody
    else can write to it.
    """
    try:
        os.makedirs(_STATE_DIR, mode=0o700, exist_ok=True)
    except OSError as exc:
        raise SystemExit(f"cpuctl: cannot create {_STATE_DIR}: {exc}")
    try:
        st = os.lstat(_STATE_DIR)
    except OSError as exc:
        raise SystemExit(f"cpuctl: cannot stat {_STATE_DIR}: {exc}")
    if not stat.S_ISDIR(st.st_mode) or stat.S_ISLNK(st.st_mode):
        raise SystemExit(f"cpuctl: {_STATE_DIR} is not a directory")
    if st.st_uid != os.getuid():
        raise SystemExit(f"cpuctl: {_STATE_DIR} is not owned by this user")
    if st.st_mode & 0o077:
        os.chmod(_STATE_DIR, 0o700)
    return _STATE_DIR


def open_nofollow(path, flags, mode=0o600):
    """Open without following a final symlink, and only if it is a regular file."""
    fd = os.open(path, flags | os.O_NOFOLLOW | os.O_CLOEXEC, mode)
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            raise OSError(f"{path} is not a regular file")
    except Exception:
        os.close(fd)
        raise
    return fd
LOCK_TIMEOUT = 5.0
# A previous sample older than this is thrown away (suspend, long gap).
MAX_SAMPLE_AGE = 60.0
# With no usable previous sample, wait this long and sample again so the
# very first poll still has a rate instead of null.
FIRST_SAMPLE_GAP = 0.25
TOP_DEFAULT = 5
# Ceiling on the pids carried between samples. The state file is rewritten on
# every poll, so it cannot be allowed to grow with the process table.
MAX_TRACKED_PROCS = 512
# Longest process name we hand to the UI; anything longer is a command line,
# not a name.
NAME_MAX = 24

# Package-level RAPL energy domains. The counter is 0400 root:root on a stock
# kernel — the mitigation for PLATYPUS (CVE-2020-8694) — so this is normally
# unreadable and every power reading comes back None. Grant read access and it
# starts working with no other change.
RAPL_GLOB = "/sys/class/powercap/intel-rapl:[0-9]*"

# A process name is whatever a local program chose to call itself, and it ends
# up in the panel and in the bar's tooltip, which renders with a Text that
# auto-detects rich text. Keep a conservative printable subset so a name can
# never carry markup into a UI sink.
_NAME_OK = re.compile(r"[^A-Za-z0-9 ._+@:-]")


def safe_name(value):
    out = _NAME_OK.sub("", str(value or ""))[:NAME_MAX].strip()
    return out or "?"

# hwmon drivers that report the CPU, best first.
CPU_HWMON = ("k10temp", "zenpower", "coretemp", "cpu_thermal", "soc_thermal", "acpitz")
# Preferred temperature labels, best first (Tctl is what AMD throttles on).
TEMP_PREFERENCE = ("Tctl", "Tdie", "Package id 0", "Composite", "CPU", "temp1")


def read(path):
    try:
        with open(path) as f:
            return f.read()
    except OSError:
        return None


def read_int(path):
    raw = read(path)
    if raw is None:
        return None
    try:
        return int(raw.strip())
    except ValueError:
        return None


def rapl_domains():
    """Package energy domains: [(energy_uj path, wrap-around maximum)]."""
    out = []
    for d in sorted(glob.glob(RAPL_GLOB)):
        name = (read(os.path.join(d, "name")) or "").strip()
        if not name.startswith("package"):
            continue
        out.append((os.path.join(d, "energy_uj"),
                    read_int(os.path.join(d, "max_energy_range_uj"))))
    return out


def rapl_power_limit_w():
    """The package power limit the kernel reports, in watts, or None.

    Intel's RAPL exposes the configured limit; AMD's does not, so this is
    None on most AMD boxes and the caller falls back to auto-ranging. No
    model lookup table: a table would be a guess, and wrong for anyone whose
    part shares a name across TDPs or who has changed the limit in firmware.
    """
    best = None
    for d in sorted(glob.glob(RAPL_GLOB)):
        name = (read(os.path.join(d, "name")) or "").strip()
        if not name.startswith("package"):
            continue
        for key in ("constraint_0_max_power_uw", "constraint_0_power_limit_uw",
                    "constraint_1_max_power_uw", "constraint_1_power_limit_uw"):
            uw = read_int(os.path.join(d, key))
            if uw and uw > 0:
                best = (best or 0) + uw / 1e6
                break
    return round(best) if best else None


def rapl_energy_uj():
    """Total package energy in microjoules, or None when it can't be read.

    None is the normal answer on a stock kernel: the counter is root-only.
    """
    domains = rapl_domains()
    if not domains:
        return None
    total = 0
    for path, _ in domains:
        v = read_int(path)
        if v is None:
            return None
        total += v
    return total


def rapl_wrap_uj():
    """Sum of the domains' wrap points, for the rare counter rollover."""
    total = 0
    for _, mx in rapl_domains():
        if not mx:
            return None
        total += mx
    return total


class Sampler:
    """Exclusive access to the sample state file.

    Everything that reads /proc/stat deltas goes through here so two callers
    (the bar poll and a terminal `cpuctl get`) don't fight over the baseline.
    """

    def __enter__(self):
        state_dir()
        # O_RDWR|O_CREAT, never O_TRUNC: the lock file's contents are
        # irrelevant, and truncating whatever is at the path is the bug.
        self._lock = os.fdopen(
            open_nofollow(LOCK_PATH, os.O_RDWR | os.O_CREAT), "r+")
        deadline = time.monotonic() + LOCK_TIMEOUT
        while True:
            try:
                fcntl.flock(self._lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() > deadline:
                    self._lock.close()
                    raise SystemExit(
                        f"cpuctl: busy (waited {LOCK_TIMEOUT:.0f}s for {LOCK_PATH})")
                time.sleep(0.05)
        return self

    def __exit__(self, *_):
        try:
            fcntl.flock(self._lock, fcntl.LOCK_UN)
        finally:
            self._lock.close()

    # ---- raw readers -------------------------------------------------

    @staticmethod
    def read_stat():
        """{'total': (busy, all), 'cores': [(busy, all), ...]} in jiffies."""
        raw = read("/proc/stat")
        if raw is None:
            return None
        total = None
        cores = []
        for line in raw.splitlines():
            if not line.startswith("cpu"):
                continue
            parts = line.split()
            vals = [int(x) for x in parts[1:9]]
            while len(vals) < 8:
                vals.append(0)
            idle = vals[3] + vals[4]
            alls = sum(vals)
            entry = (alls - idle, alls)
            if parts[0] == "cpu":
                total = entry
            else:
                cores.append(entry)
        if total is None:
            return None
        return {"total": total, "cores": cores}

    @staticmethod
    def read_procs():
        """{pid: [jiffies, name]} for every process we can read."""
        out = {}
        for path in glob.glob("/proc/[0-9]*/stat"):
            raw = read(path)
            if not raw:
                continue
            try:
                open_paren = raw.index("(")
                close_paren = raw.rindex(")")
                comm = raw[open_paren + 1:close_paren]
                rest = raw[close_paren + 2:].split()
                jiffies = int(rest[11]) + int(rest[12])
                pid = int(raw[:open_paren].strip())
            except (ValueError, IndexError):
                continue
            out[pid] = [jiffies, comm]
        return out

    @staticmethod
    def nice_name(pid, comm):
        """A short, readable name: /proc/<pid>/comm, widened from argv[0] only
        when comm is truncated (it caps at 15 chars).

        argv[0] needs care. Chromium and friends rewrite their cmdline as one
        space-separated string rather than NUL-separated argv, so splitting on
        NUL alone hands back the entire 400-character command line.
        """
        raw = read(f"/proc/{pid}/cmdline")
        if raw:
            first = raw.split("\0", 1)[0].split()[0] if raw.split("\0", 1)[0].strip() else ""
            base = os.path.basename(first)[:NAME_MAX]
            if base and (base.startswith(comm) or len(comm) >= 15):
                return safe_name(base)
        return safe_name(comm)

    # ---- state -------------------------------------------------------

    @staticmethod
    def load_state():
        raw = None
        try:
            fd = open_nofollow(STATE_PATH, os.O_RDONLY)
            try:
                raw = os.read(fd, MAX_STATE_BYTES).decode("utf-8", "replace")
            finally:
                os.close(fd)
        except OSError:
            raw = None
        if not raw:
            return None
        try:
            d = json.loads(raw)
        except ValueError:
            return None
        if not isinstance(d, dict) or "ts" not in d:
            return None
        if time.time() - float(d["ts"]) > MAX_SAMPLE_AGE:
            return None
        return d

    @staticmethod
    def save_state(state):
        # mkstemp gives an exclusive, randomly named 0600 file in our own
        # directory; nothing predictable is opened for writing.
        tmp = None
        try:
            state_dir()
            fd, tmp = tempfile.mkstemp(prefix="state.", suffix=".tmp",
                                       dir=_STATE_DIR)
            with os.fdopen(fd, "w") as f:
                json.dump(state, f, separators=(",", ":"))
            os.replace(tmp, STATE_PATH)
            tmp = None
        except OSError:
            pass
        finally:
            if tmp is not None:
                try:
                    os.unlink(tmp)
                except OSError:
                    pass

    # ---- the sample --------------------------------------------------

    def sample(self, top_n=TOP_DEFAULT):
        prev = self.load_state()
        stat = self.read_stat()
        if stat is None:
            return None
        procs = self.read_procs()
        energy = rapl_energy_uj()
        now = time.time()

        if prev is None or prev.get("total", [0, 0])[1] > stat["total"][1]:
            # No baseline (first run, or counters went backwards after a
            # reboot): take a short second sample so we still return rates.
            prev = {"ts": now, "total": stat["total"], "cores": stat["cores"],
                    "procs": {str(p): v[0] for p, v in procs.items()},
                    "energy": energy}
            time.sleep(FIRST_SAMPLE_GAP)
            stat = self.read_stat() or stat
            procs = self.read_procs() or procs
            energy = rapl_energy_uj()
            now = time.time()

        def pct(cur, old):
            d_all = cur[1] - old[1]
            if d_all <= 0:
                return 0.0
            return max(0.0, min(100.0, 100.0 * (cur[0] - old[0]) / d_all))

        usage = pct(stat["total"], prev["total"])
        prev_cores = prev.get("cores") or []
        per_core = [pct(c, prev_cores[i]) if i < len(prev_cores) else 0.0
                    for i, c in enumerate(stat["cores"])]

        # Per-process share, expressed like top(1): percent of one core.
        ncpu = max(1, len(stat["cores"]))
        d_all = stat["total"][1] - prev["total"][1]
        prev_procs = prev.get("procs") or {}
        top = []
        if d_all > 0:
            for pid, (jiffies, comm) in procs.items():
                old = prev_procs.get(str(pid))
                if old is None:
                    continue
                d = jiffies - old
                if d <= 0:
                    continue
                share = 100.0 * d / d_all * ncpu
                top.append((share, pid, comm))
        top.sort(reverse=True)
        top_list = [{"pid": pid, "name": self.nice_name(pid, comm), "cpu": round(share, 1)}
                    for share, pid, comm in top[:top_n]]

        # Package watts = energy burned between the two samples / elapsed time.
        elapsed = now - float(prev["ts"])
        watts = None
        prev_energy = prev.get("energy")
        if energy is not None and prev_energy is not None and elapsed > 0:
            delta = energy - prev_energy
            if delta < 0:                      # counter wrapped
                wrap = rapl_wrap_uj()
                delta = delta + wrap if wrap else None
            if delta is not None and delta >= 0:
                w = delta / 1e6 / elapsed
                # A implausible figure means the counter moved for a reason
                # other than elapsed time; report nothing rather than nonsense.
                watts = round(w, 1) if 0 <= w < 1000 else None

        # Keep only the busiest pids: enough for a meaningful top list, and a
        # bound on what gets written back every poll.
        busiest = sorted(procs.items(), key=lambda kv: -kv[1][0])[:MAX_TRACKED_PROCS]
        self.save_state({"ts": now, "total": stat["total"], "cores": stat["cores"],
                         "procs": {str(pid): v[0] for pid, v in busiest},
                         "energy": energy})

        return {
            "usage": round(usage, 1),
            "perCore": [round(v) for v in per_core],
            "top": top_list,
            "packageW": watts,
            "sampleSec": round(elapsed, 2),
        }


# ---- static / instantaneous readings ------------------------------------

def cpu_model():
    raw = read("/proc/cpuinfo") or ""
    model = ""
    cores = None
    for line in raw.splitlines():
        if not model and line.startswith("model name"):
            model = line.split(":", 1)[1].strip()
        elif cores is None and line.startswith("cpu cores"):
            try:
                cores = int(line.split(":", 1)[1])
            except ValueError:
                cores = None
        if model and cores is not None:
            break
    threads = os.cpu_count() or len(re.findall(r"^processor", raw, re.M)) or None
    return {"model": model or "CPU", "cores": cores or threads, "threads": threads}


def cpu_freq():
    """Average current MHz across policies, and the top MHz. None if no cpufreq."""
    cur = []
    top = None
    for base in glob.glob("/sys/devices/system/cpu/cpu[0-9]*/cpufreq"):
        khz = read_int(os.path.join(base, "scaling_cur_freq"))
        if khz:
            cur.append(khz / 1000.0)
        mx = read_int(os.path.join(base, "cpuinfo_max_freq"))
        if mx:
            top = max(top or 0, mx / 1000.0)
    if cur:
        return {"freqMhz": round(sum(cur) / len(cur)), "maxFreqMhz": round(top) if top else None}
    # Fallback: /proc/cpuinfo "cpu MHz" lines.
    raw = read("/proc/cpuinfo") or ""
    vals = [float(m) for m in re.findall(r"^cpu MHz\s*:\s*([0-9.]+)", raw, re.M)]
    if vals:
        return {"freqMhz": round(sum(vals) / len(vals)), "maxFreqMhz": None}
    return {"freqMhz": None, "maxFreqMhz": None}


def cpu_temps():
    """{'sensor': driver, 'temps': [{'label','c'}]} from the best CPU hwmon."""
    found = []
    for hw in sorted(glob.glob("/sys/class/hwmon/hwmon*")):
        name = (read(os.path.join(hw, "name")) or "").strip()
        if name not in CPU_HWMON:
            continue
        temps = []
        for inp in sorted(glob.glob(os.path.join(hw, "temp*_input"))):
            milli = read_int(inp)
            if milli is None:
                continue
            label = (read(inp.replace("_input", "_label")) or "").strip()
            if not label:
                label = os.path.basename(inp).replace("_input", "")
            temps.append({"label": label, "c": round(milli / 1000.0, 1)})
        if temps:
            found.append((CPU_HWMON.index(name), name, temps))
    if found:
        found.sort()
        _, name, temps = found[0]
        return {"sensor": name, "temps": temps}
    # Fallback: thermal zones that look like a CPU.
    for zone in sorted(glob.glob("/sys/class/thermal/thermal_zone*")):
        ztype = (read(os.path.join(zone, "type")) or "").strip()
        if not re.search(r"cpu|pkg|x86|soc", ztype, re.I):
            continue
        milli = read_int(os.path.join(zone, "temp"))
        if milli is not None:
            return {"sensor": ztype, "temps": [{"label": ztype, "c": round(milli / 1000.0, 1)}]}
    return {"sensor": None, "temps": []}


def pick_temp(temps, preferred="auto"):
    """The headline temperature: the preferred label if present, else the
    first label in TEMP_PREFERENCE, else the hottest reading."""
    if not temps:
        return None
    if preferred and preferred != "auto":
        for t in temps:
            if t["label"] == preferred:
                return t["c"]
    for label in TEMP_PREFERENCE:
        for t in temps:
            if t["label"] == label:
                return t["c"]
    return max(t["c"] for t in temps)


def load_avg():
    raw = read("/proc/loadavg")
    if not raw:
        return None
    try:
        return [float(x) for x in raw.split()[:3]]
    except ValueError:
        return None


def memory():
    raw = read("/proc/meminfo") or ""
    vals = {}
    for line in raw.splitlines():
        parts = line.split()
        if len(parts) >= 2 and parts[0] in ("MemTotal:", "MemAvailable:"):
            try:
                vals[parts[0][:-1]] = int(parts[1])
            except ValueError:
                pass
    total = vals.get("MemTotal")
    avail = vals.get("MemAvailable")
    if not total or avail is None:
        return {"memUsedPct": None, "memUsedGiB": None, "memTotalGiB": None}
    used = total - avail
    return {"memUsedPct": round(100.0 * used / total, 1),
            "memUsedGiB": round(used / 1048576.0, 1),
            "memTotalGiB": round(total / 1048576.0, 1)}


def get(top_n=TOP_DEFAULT):
    """Everything the panel shows, as one dict. None = unsupported here."""
    with Sampler() as s:
        sample = s.sample(top_n)
    if sample is None:
        return None
    state = {"present": True}
    state.update(cpu_model())
    state.update(sample)
    state.update(cpu_freq())
    temps = cpu_temps()
    state["sensor"] = temps["sensor"]
    state["temps"] = temps["temps"]
    state["tempC"] = pick_temp(temps["temps"])
    state["powerPresent"] = bool(rapl_domains())
    state["powerLimitW"] = rapl_power_limit_w()
    state["load"] = load_avg()
    state.update(memory())
    return state


# ---- doctor -------------------------------------------------------------

def doctor():
    checks = []

    def add(ok, label, detail="", fix=""):
        checks.append((ok, label, detail, fix))

    # 1. sources, cheapest first
    add(read("/proc/stat") is not None, "/proc/stat readable", "",
        "this is a Linux-only plugin; /proc must be mounted")
    freq = cpu_freq()
    add(True, "CPU clock",
        f"{freq['freqMhz']} MHz" if freq["freqMhz"] else "no cpufreq; clock hidden in the panel")
    temps = cpu_temps()
    add(True, "CPU temperature",
        f"{temps['sensor']}: " + ", ".join(f"{t['label']} {t['c']}°C" for t in temps["temps"])
        if temps["temps"] else "no CPU hwmon found; temperature hidden in the panel")
    energy = rapl_energy_uj()
    add(True, "CPU package power",
        "readable" if energy is not None else
        "counter is root-only (PLATYPUS mitigation); power hidden in the panel",
        "" if energy is not None else
        "grant read access to /sys/class/powercap/intel-rapl:*/energy_uj")

    try:
        d = state_dir()
        fd, probe = tempfile.mkstemp(prefix="probe.", dir=d)
        os.close(fd)
        os.unlink(probe)
        add(True, "Runtime dir private and writable", d)
    except OSError as exc:
        add(False, "Runtime dir writable", str(exc), "export XDG_RUNTIME_DIR to a writable directory")
    try:
        state = get()
        add(state is not None, "Sample succeeds",
            f"usage {state['usage']}% over {state['sampleSec']}s" if state else "",
            "run with python3 -X dev to see the traceback")
    except SystemExit as exc:
        add(False, "Sample succeeds", str(exc), f"rm {LOCK_PATH}")

    # 2. plugin
    plug = os.path.expanduser("~/.config/omarchy/plugins/" + PLUGIN_ID)
    add(os.path.isdir(plug), "Plugin installed", plug,
        "omarchy plugin add " + REPO_URL + " --enable")
    missing = [f for f in REQUIRED_FILES if not os.path.exists(os.path.join(plug, f))]
    add(not missing, "Plugin files present",
        "missing: " + ", ".join(missing) if missing else "",
        "omarchy plugin update " + PLUGIN_ID)

    # 3. bar layout
    try:
        with open(os.path.expanduser("~/.config/omarchy/shell.json")) as f:
            layout = json.load(f).get("bar", {}).get("layout", {})
        placed = any(PLUGIN_ID == w.get("id")
                     for sec in layout.values() for w in sec if isinstance(w, dict))
    except (OSError, ValueError, AttributeError):
        placed = False
    add(placed, "Widget placed in the bar", "",
        "omarchy plugin enable " + PLUGIN_ID + " --section right")

    width = max(len(c[1]) for c in checks)
    failed = 0
    for ok, label, detail, fix in checks:
        mark = "ok  " if ok else "FAIL"
        line = f"  [{mark}] {label.ljust(width)}"
        if detail:
            line += f"  {detail}"
        print(line)
        if not ok and fix:
            print(f"         -> {fix}")
        failed += 0 if ok else 1
    print()
    if failed:
        print(f"  {failed} check(s) failed.")
    else:
        print("  All checks passed. If the widget is still missing, give it "
              "5s to poll, then: omarchy restart shell")
    return 1 if failed else 0


# ---- CLI ---------------------------------------------------------------

def print_human(state):
    print(f"  {state['model']}  ({state['cores']} cores / {state['threads']} threads)")
    print(f"  usage   {state['usage']}%  over {state['sampleSec']}s")
    print("  cores   " + " ".join(f"{v:3d}" for v in state["perCore"]))
    if state["freqMhz"]:
        top = f" of {state['maxFreqMhz']}" if state["maxFreqMhz"] else ""
        print(f"  clock   {state['freqMhz']} MHz{top}")
    if state["temps"]:
        print("  temp    " + "  ".join(f"{t['label']} {t['c']}°C" for t in state["temps"]))
    if state["load"]:
        print("  load    " + "  ".join(f"{v:.2f}" for v in state["load"]))
    if state["packageW"] is not None:
        cap = f" of {state['powerLimitW']} W" if state.get("powerLimitW") else ""
        print(f"  power   {state['packageW']} W{cap}")
    if state["memUsedPct"] is not None:
        print(f"  memory  {state['memUsedGiB']} / {state['memTotalGiB']} GiB ({state['memUsedPct']}%)")
    if state["top"]:
        print("  top     " + "  ".join(f"{p['name']} {p['cpu']}%" for p in state["top"]))


def main():
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--json", action="store_true", default=argparse.SUPPRESS,
                        help="machine-readable output")

    ap = argparse.ArgumentParser(prog="cpuctl", parents=[common],
                                 description=__doc__.split("\n\n")[1])
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("get", parents=[common])
    sub.add_parser("doctor", parents=[common])
    p = sub.add_parser("top", parents=[common])
    p.add_argument("-n", type=int, default=TOP_DEFAULT)

    args = ap.parse_args()
    as_json = getattr(args, "json", False)

    if args.cmd == "doctor":
        return doctor()

    if args.cmd == "get":
        state = get()
        if state is None:
            raise SystemExit("cpuctl: /proc/stat unreadable")
        if as_json:
            print(json.dumps(state))
        else:
            print_human(state)
        return 0

    if args.cmd == "top":
        state = get(top_n=max(1, args.n))
        if state is None:
            raise SystemExit("cpuctl: /proc/stat unreadable")
        if as_json:
            print(json.dumps(state["top"]))
        else:
            for p in state["top"]:
                print(f"  {p['cpu']:6.1f}%  {p['pid']:>7}  {p['name']}")
        return 0
    return 0


if __name__ == "__main__":
    sys.exit(main())
